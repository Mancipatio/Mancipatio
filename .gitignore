# Markdown files and the top-level docs/ directories are not tracked.
# The docs/ rules are anchored so application routes such as front/app/docs
# stay tracked. The one exception is the mainnet runbook, which the chain CLI
# (front/scripts/chain) and the Release workflow refer to by path.
*.md
!/ops/runbook-mainnet.md
/docs/
/front/docs/
/program/docs/

# Local env files and wallet keypairs are never committed.
.env
.env.*
!.env.example
*-keypair.json
id.json
id-*.json

.DS_Store

# ── Network selection ────────────────────────────────────────────────────────
# The single switch that moves the whole app between clusters. Client pages
# derive their RPC from it (lib/network.ts rpcUrl()); server authorization
# uses lib/server/rpc.ts, which FAILS CLOSED on mainnet when no mainnet RPC
# is configured (it will not silently evaluate admin checks against devnet).
#
#   devnet (default) | mainnet | testnet | localnet
NEXT_PUBLIC_NETWORK=devnet

# RPC genesis identity is verified before wallet transactions and server RPC
# reads. Public networks use their canonical hashes. For localnet, set its
# actual `solana genesis-hash --url http://127.0.0.1:8899` output before building.
# NEXT_PUBLIC_SOLANA_GENESIS_HASH=

# Canonical HTTPS origin. Required before build for SIWS origin verification
# as well as onboarding/email links. Redirect other domains to this origin.
NEXT_PUBLIC_SITE_URL=https://www.mancipatio.io

# Optional explicit client RPC — overrides the URL derived from the network.
# On mainnet set this to a paid endpoint (public mainnet-beta RPC is heavily
# rate-limited): e.g. https://mainnet.helius-rpc.com/?api-key=…
# NEXT_PUBLIC_SOLANA_RPC_URL=

# Server-side RPC per network (lib/server/rpc.ts). HELIUS_MAINNET_RPC (or
# SOLANA_MAINNET_RPC) is REQUIRED when NEXT_PUBLIC_NETWORK=mainnet.
# HELIUS_DEVNET_RPC=
# HELIUS_MAINNET_RPC=
# SOLANA_MAINNET_RPC=

# ── Supabase ─────────────────────────────────────────────────────────────────
# NEXT_PUBLIC_SUPABASE_URL=
# NEXT_PUBLIC_SUPABASE_ANON_KEY=
# SUPABASE_SERVICE_ROLE_KEY=

# ── Email (Resend) — KYC decision + onboarding mail ─────────────────────────
# RESEND_API_KEY=
# EMAIL_FROM=
# CONTACT_NOTIFY_EMAIL=

# ── Your Account — Google connection + verified contact email ────────────────
# Google OAuth client type: Web application. Register this exact redirect:
#   https://YOUR_CANONICAL_DOMAIN/api/account/google/callback
# Local preview: http://127.0.0.1:3000/api/account/google/callback
# Server-only credentials. Never add NEXT_PUBLIC_ prefixes to these values.
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# Email verification uses RESEND_API_KEY and EMAIL_FROM above. Configure a
# verified sender domain in Resend. Both must be present to enable the UI.
# Apply supabase/migrations/0052_account_profiles.sql, then
# supabase/migrations/0053_account_wallets.sql before using /account.

# ── Edge function (supabase/functions/helius-webhook) ───────────────────────
# Set per DEPLOYED FUNCTION, not here: INDEXER_NETWORK (devnet|mainnet),
# HELIUS_WEBHOOK_SECRET (32+ characters). One deployment indexes ONE network —
# for a devnet+mainnet split, deploy a second copy under another name.

# Server-only secret (32+ random characters) for the internal retry worker.
# Pass in Authorization: Bearer; never in a query string or NEXT_PUBLIC variable.
RETRY_WORKER_SECRET=

# ── Network-aware build ──────────────────────────────────────────────────────
# NEXT_PUBLIC_NETWORK (mainnet | devnet | testnet | localnet) is REQUIRED on
# Vercel: next.config.ts fails every Vercel build (Production and Preview)
# where it is unset or invalid instead of guessing from the RPC URL.
# Optional WebSocket (subscriptions) endpoint. Default: NEXT_PUBLIC_SOLANA_RPC_URL
# with https→wss / http→ws (localnet without an RPC URL: ws://127.0.0.1:8900).
# NEXT_PUBLIC_SOLANA_WS_URL=
# Search indexing: noindex everywhere unless NEXT_PUBLIC_NETWORK=mainnet AND
# this is exactly "true" (robots.txt + robots meta; see lib/indexing.ts).
# NEXT_PUBLIC_ALLOW_INDEXING=
# Feature flags (lib/features.ts): always on for devnet/testnet/localnet; on
# mainnet each is on only when exactly "true". Inlined at build time.
# NEXT_PUBLIC_FEATURE_PAYOUT_AIRDROP=
# NEXT_PUBLIC_FEATURE_STARTUP_RAISES=

# ── Cloudflare Turnstile (optional; bot check on email sign-in + contact form) ─
# Set BOTH or neither. With only the secret set, the server requires a token
# that no page can produce, so email sign-in and the contact form stop working.
# Public site key: the widget renders (and Cloudflare's script loads) only when
# set. Inlined at build time — changing it needs a rebuild.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
# Server secret: when set, /api/auth/email/start and /api/inquiries/create
# verify the token (action + hostname = NEXT_PUBLIC_SITE_URL) and fail closed.
# Cloudflare's test secrets work outside production only.
TURNSTILE_SECRET_KEY=
